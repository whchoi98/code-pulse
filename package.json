{
  "name": "code-pulse",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Daily Korean briefings for Claude Code, Codex and Kiro from official sources",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "node tools/build.mjs",
    "start": "node dist/server/index.js",
    "collect": "tsx src/collector/run.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy --require-approval never --outputs-file cdk-outputs.json",
    "release:sync": "node tools/release-docs.mjs --write",
    "release:check": "node tools/release-docs.mjs --check",
    "prebuild": "npm run release:check",
    "predeploy": "npm run release:check"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "@fastify/compress": "^8.0.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^5.0.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "aws-cdk": "^2.1000.0",
    "aws-cdk-lib": "^2.200.0",
    "cdk-nag": "^2.35.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
